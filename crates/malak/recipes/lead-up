#!/bin/sh
set -eu

recipes=$(CDPATH='' cd "$(dirname "$0")" && pwd)
. "$recipes/board.sh"

usage() {
    mode=${1:-help}
    set -- 'Usage: malak recipe lead-up [[--] NAME | --board NAME | --config PATH] | --list | --tree' \
        '       malak recipe lead-up NAME --parent PARENT [--id ID] [--handover PATH]'
    if [ "$mode" = help ]; then
        set -- "$@" '' \
            'Run this in your agent shell to become or take over as the lead.' \
            'Use your project folder name unless the owner gave you another board name.' \
            'A new name creates a board. A takeover uses the same name as the previous lead.' \
            'Unset any inherited MALAK_HANDOVER before setting up as lead.' \
            'Apply the printed export in your shell. If each command starts a fresh shell,' \
            'set MALAK_HANDOVER to the printed path for each command.' \
            'Pass --board NAME on every board command, including the lead watcher.' \
            'Watch the lead inbox with malak --board NAME mailbox --plain --for lead.' \
            'Poll with malak --board NAME read --wait 60 lead questions if needed.' \
            'Read orders in force with malak --board NAME mailbox --orders before acting.' \
            'On takeover, read unacknowledged messages with malak --board NAME read lead first.' \
            'Then check questions, mailbox --waiting and mailbox --trace ID on that board.'
    fi
    recipe_usage "$mode" "$@"
}

fail_usage() {
    usage error >&2
    exit 2
}

config=
name=
case ${1-} in
    --list|--tree)
        [ "$#" -eq 1 ] || fail_usage
        exec python3 "$recipes/board_data.py" "${1#--}" ;;
    -h|--help) usage; exit 0 ;;
    --board|--config)
        [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage
        config=$(recipe_config_option "$1" "$2")
        shift 2 ;;
    --)
        [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage
        name=$2
        shift 2 ;;
    -*) fail_usage ;;
    ?*)
        name=$1
        shift ;;
esac
if [ -n "$name" ]; then recipe_config "$name" >/dev/null; fi

if [ "$#" -eq 0 ]; then
    if [ -n "$name" ]; then config=$(board_config "$name" --create); fi
    config=${config:-$(board_config)}
    exec python3 "$recipes/board_data.py" lead-up "$config"
fi

[ "$#" -ge 2 ] && [ "$1" = --parent ] && [ -n "$2" ] || fail_usage
[ -n "$name$config" ] || fail_usage
parent=$(board_config "$2")
shift 2
id=${MALAK_PARTICIPANT_ID-}
handover=${MALAK_HANDOVER-}
while [ "$#" -gt 0 ]; do
    [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage
    case $1 in
        --id) id=$2 ;;
        --handover) handover=$2 ;;
        *) fail_usage ;;
    esac
    shift 2
done
if [ -n "$name" ]; then config=$(board_config "$name" --create); fi
MALAK_PARTICIPANT_ID=$id MALAK_HANDOVER=$handover \
    exec python3 "$recipes/board_data.py" lead-up "$config" "$parent"
