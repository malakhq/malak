#!/usr/bin/env python3
"""Show the stock workers on a local board."""

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True

import board_data as board
from recipe_board import board_config, selected_config
import recipe_output as out
from worker_queue import LaunchRecord, QueueBoard, QueueError


def enrolled(person):
    return (person.get("enrolled_at_ms") or 0, person["id"])


def workers(connection, name):
    people = connection.status()["participants"]
    # The active enrolment of a name is its newest one that is not revoked.
    active = {}
    for person in sorted((person for person in people if not person["revoked"]), key=enrolled):
        active[person["name"]] = person["id"]
    participants = sorted(people, key=lambda person: (
        person["name"], active.get(person["name"]) != person["id"],
        -(person.get("enrolled_at_ms") or 0), person["id"],
    ))
    for person in participants:
        if (name is not None and person["name"] != name
                or person["id"] == "lead" and name != "lead"):
            continue
        record = LaunchRecord(connection.state, person["id"])
        evidence, live = record.observe()
        claim = person.get("claim")
        if not record.on_board(evidence, connection.identity):
            if claim is None:
                continue
            evidence = {}
            live = False
        exit_code = evidence.get("last_exit_status", evidence.get("exit_status"))
        if not evidence:
            state = claim["state"]
        elif evidence.get("phase") == "adopted":
            state = "adopted"
        else:
            state = "running" if live else "exited"
        unread = connection.unread(person["id"]) if state == "exited" else None
        yield {
            "name": person["name"],
            "state": state,
            "launcher_pid": evidence.get("launcher_pid"),
            "agent_pid": evidence.get("agent_pid"),
            "started_at_ms": evidence.get("started_at_ms"),
            "exit_code": None if live else exit_code,
            "inbox": record.id if record.id == "lead" else f"to/{record.id}",
            "enrolment": "revoked" if person["revoked"] else "active",
            "active": active.get(person["name"]) == person["id"],
            **({"unread": unread} if unread is not None else {}),
            **({"reissue": reissue(person["name"], state)} if claim and claim["state"] == "ended" else {}),
            **({"claim": claim} if claim is not None else {}),
        }


def reissue(name, state):
    # The board's claim notice names no command; this is where it is named.
    if state == "adopted":
        return f"malak recipe adopt {name}"
    return f"malak recipe worker-start {name} --again"


def stamp(ms):
    return datetime.fromtimestamp(ms / 1000, timezone.utc).isoformat()


def claim_fields(claim):
    session = claim["session"]
    yield ("Claim", claim["state"])
    yield ("Session", process_text(session))
    yield ("Issuer", claim["issuer"])
    if claim["refused"]:
        yield ("Refused", f"{claim['refused']} (last {stamp(claim['last_refused_at_ms'])})")
    for event in claim["history"]:
        details = event.get("session") or event.get("peer")
        label = f"{stamp(event['at_ms'])} {event['event']}"
        yield ("History", f"{label} {process_text(details)}" if details else label)


def process_text(details):
    folder = details.get("folder") or details.get("cwd")
    return f"PID {details.get('pid') or '?'} {details.get('program') or '?'} ({folder or 'folder unavailable'})"


def main():
    parser = out.ArgumentParser(
        prog="malak recipe workers",
        usage="%(prog)s [NAME] [--all] [--json] [--config PATH | --board NAME]",
        allow_abbrev=False,
    )
    parser.add_argument("name", nargs="?", metavar="NAME", help="Show only this worker name")
    parser.add_argument("--all", action="store_true",
                        help="Also show each name's older enrolments (default: the active one)")
    parser.add_argument("--json", action="store_true", help="Print worker records as JSON")
    selectors = parser.add_mutually_exclusive_group()
    selectors.add_argument("--board", metavar="NAME", help="Select a named board")
    selectors.add_argument("--config", type=Path, metavar="PATH", help="Select a board config")
    args = parser.parse_args()

    config = (selected_config(args.board, args.config) or board_config()).absolute()
    with config.open("rb") as source:
        connection = QueueBoard(config, board.board_state(source).absolute())
    if handover := os.environ.get("MALAK_HANDOVER"):
        board.check_board(config, handover)
    rows = list(workers(connection, args.name))
    if args.name is not None and not rows:
        raise QueueError(f"no stock worker named {args.name!r}")
    if args.json:
        print(json.dumps({"workers": rows}))
    elif not rows:
        out.details("No stock workers.")
    else:
        if not args.all:
            # Rows are ordered active first, so the first of each name is the one to show.
            first = {}
            for row in rows:
                first.setdefault(row["name"], row)
            rows = list(first.values())
        for row in rows:
            started = row["started_at_ms"]
            time = (datetime.fromtimestamp(started / 1000, timezone.utc).isoformat()
                    if started is not None else None)
            label = row["state"]
            if label == "adopted":
                label = "adopted (no launcher)"
                fields = [("Agent PID", row["agent_pid"]), ("Inbox", row["inbox"]),
                          ("Enrolment", row["enrolment"])]
            elif row["launcher_pid"] is None and row["agent_pid"] is None and started is None:
                # Workers launched before launch records existed have only board state.
                fields = [("Launch record", "none (started by an older Malak)"),
                          ("Inbox", row["inbox"]), ("Enrolment", row["enrolment"])]
            else:
                fields = [("Launcher PID", row["launcher_pid"]), ("Agent PID", row["agent_pid"]),
                          ("Started", time), ("Inbox", row["inbox"]), ("Enrolment", row["enrolment"])]
            if row["state"] == "exited":
                fields.append(("Exit code", row["exit_code"]))
                if "unread" in row:
                    fields.append(("Unread", row["unread"]))
            if "reissue" in row:
                fields.append(("Re-issue", row["reissue"]))
            if claim := row.get("claim"):
                fields.extend(claim_fields(claim))
            out.details(f"{row['name']} {label}",
                        [(label, "Unavailable" if value is None else value) for label, value in fields])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (board.RecipeError, OSError, KeyError, ValueError) as error:
        out.error("show workers", error, "Check the selected board and worker name.")
        sys.exit(getattr(error, "code", 3))
