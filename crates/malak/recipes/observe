#!/usr/bin/env python3
"""Show Malak's session nudge from an agent tool's command hook."""

from contextlib import suppress
import fcntl
from functools import cache
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import signal
import stat
import sys
import time

import adapters
import hook_format
import recipe_output as out
from board_data import (
    RecipeError, ack_command, board_status, channel_status, first_due, guest_command, guest_grant, malak,
)
from delegation import PREFIX as DELEGATION_PREFIX, reminder as delegation_reminder, starts_worker
from question_hooks import async_replies, is_question, note_async_replies, record, translate
from recipe_board import (
    board_entries, board_identity, board_name, board_selector, board_settings, config_for_socket,
    lead_watcher_command, local_board_label, matches_session, selected_config,
)


COOLDOWN_SECONDS = 60
LEAD_STATUS_INTERVAL_SECONDS = 3 * 60
REMINDER_BYTES = 600
INTRO = "Malak is installed for visibility."
NO_BOARD = (
    "Malak is installed. If this chat already leads a board, keep leading it with its --board name. "
    "Otherwise ask the owner before leading or joining a board."
)
TASK_TOOLS = adapters.union("plan_tools")
AGENT_TOOLS = adapters.union("activity_tools")
SHELL_TOOLS = adapters.union("shell_tools")
START_SOURCES = {"startup", "resume", "fork"}


class HookDeadline(Exception):
    pass


def worker_context(board, participant, config, handover, intro, review):
    name = local_board_label(board)
    status = None
    if config is not None:
        try:
            name = board_name(config)
            status = read_status(config)
        except (HookDeadline, OSError, ValueError):
            pass
    lines = []
    person = next((person for person in (status or {}).get("participants", [])
                   if person["id"] == participant), None)
    if intro:
        label = person["name"] if person else participant
        lines.append(
            f"{INTRO} You are {label} on board {json.dumps(name)}. "
            "Use the inherited MALAK_HANDOVER for this session and its subagents. "
            "Ask the person before joining another board."
        )
    if review:
        command = f"malak {board_selector(config, name)}" if config else "malak"
        inbox = f"to/{participant}"
        channel = channel_status(status, inbox) if status else None
        if person and not person["revoked"] and person["grant"] == guest_grant(inbox):
            from lead_status import available, first_waiting

            if channel and (pos := available(first_waiting, config, handover, channel, participant)):
                command = guest_command(handover)
                ack = ack_command(command, inbox, channel["creation"], pos)
                lines.append(f"Guest reply waiting: `{command} read --limit 1 {inbox}`, handle, then `{ack}`.")
        else:
            if channel and first_due(channel, participant) < channel["head"]:
                lines.append(f"Inbox waiting: `{command} read --ack {inbox}`")
            lines.append(f"Report when done: `{command} send --kind report lead -`")
    return lines


def lead_handover_for(config):
    try:
        settings = board_settings(config)
        handover = Path(settings["state"]) / "lead.handover"
        if board_identity(handover) == (Path(settings["socket_folder"]), "lead"):
            return handover
    except (KeyError, OSError, TypeError, ValueError):
        pass
    return None


def lead_context(name, config):
    return (
        f"{INTRO} You lead board {json.dumps(name)}. "
        f"Run `{lead_watcher_command(config, name)}` in the background. "
        "Handle the output, acknowledge lead messages, and run it again."
    )


def read_status(config):
    try:
        return board_status(config, check=False)
    except (RecipeError, OSError, ValueError):
        return None


@cache
def hook_process():
    try:
        return json.loads(malak("recipe", "__session-process").stdout)
    except (RecipeError, OSError, ValueError):
        return None


def matching_leads(config, session_id):
    try:
        entries = [(board_name(config), config)] if config is not None else sorted(board_entries())
        for name, path in entries:
            if status := read_status(path):
                if matches_session(status.get("lead_session"), session_id, hook_process):
                    yield name, path, status
    except (OSError, ValueError):
        # An unavailable board cannot establish leadership.
        return


def hook_context(config, handover, intro, session_id, *, installed=False, review=False,
                 question=None, replied=(), delegating=None):
    inherited_board = None
    if handover is not None:
        board, participant = board_identity(handover)
        if participant != "lead" and not (intro or review):
            return []
        if config is None and participant != "lead":
            try:
                config = config_for_socket(board)
            except (HookDeadline, OSError, ValueError):
                pass
        if config is not None and Path(board_settings(config)["socket_folder"]) != board:
            raise ValueError("MALAK_HANDOVER does not match the selected board")
        if participant != "lead":
            return worker_context(board, participant, config, handover, intro, review)
        inherited_board = board
    lines = []
    try:
        from lead_status import reminder_lines

        leads = list(matching_leads(config, session_id))
        if not leads:
            return [NO_BOARD] if intro else []
        # A globally installed hook must never guess which of several boards
        # should receive a question. An explicit config is already a selection.
        if (question or replied) and len(leads) == 1:
            _, path, status = leads[0]
            same_board = inherited_board is None or Path(board_settings(path)["socket_folder"]) == inherited_board
            if same_board and (lead_handover := lead_handover_for(path)):
                try:
                    if question:
                        review = record(question, path, lead_handover, status) or review
                    else:
                        review = note_async_replies(replied, path, status, session_id) or review
                except (RecipeError, OSError, ValueError, KeyError, TypeError):
                    pass
        if review or (intro and installed) or (question and len(leads) > 1):
            if len(leads) == 1:
                name, path, _ = leads[0]
                command = f"malak {board_selector(path, name)} recipe ask ..."
                lines.append(f"Asking the owner something? Use the question tool, or run `{command}` before writing it in chat.")
            else:
                lines.append(
                    "Asking the owner something? This chat leads several boards. "
                    "Choose one with `malak recipe ask --board BOARD ...` before writing in chat."
                )
            if intro:
                identity = " ".join(f"You lead board {json.dumps(name)}." for name, _, _ in leads)
                first = f"{INTRO} {identity} {lines[0]}"
                if len(first.encode()) <= REMINDER_BYTES:
                    lines[0] = first
            if review:
                for name, path, status in leads:
                    if lead_handover := lead_handover_for(path):
                        lines.extend(reminder_lines(name, path, lead_handover, status, session_id))
        elif intro:
            lines.extend(lead_context(name, path) for name, path, _ in leads)
        if delegating and len(leads) == 1:
            name, path, _ = leads[0]
            lines.insert(0, delegation_reminder(delegating, f"malak {board_selector(path, name)}"))
        elif delegating:
            lines.insert(0, delegation_reminder(delegating, "malak --board BOARD"))
    except HookDeadline:
        # Keep completed reviews if a later board runs out of time.
        pass
    return lines or ([NO_BOARD] if intro else [])


def bounded_context(lines):
    kept = []
    # The delegation line has its own room, so it never crowds out the mail lines.
    remaining = REMINDER_BYTES + sum(
        len(line.encode()) + 1 for line in lines if line.startswith(DELEGATION_PREFIX)
    )
    for line in lines:
        size = len(line.encode())
        if size <= remaining:
            kept.append(line)
            remaining -= size + 1
        if len(kept) == 5:
            break
    return "\n".join(kept)


def detached(tool_input):
    if tool_input.get("run_in_background") is True:
        return True
    command = tool_input.get("command")
    if not isinstance(command, str) or "\n" in command.strip():
        return False
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        words = list(lexer)
    except ValueError:
        return False
    if not words:
        return False
    if words[-1] == "&" and re.search(r"(?<![\\&])&\s*$", command):
        return True
    if Path(words[0]).name != "malak":
        return False
    args = iter(words[1:])
    command = []
    for word in args:
        if word in {"--config", "--board"}:
            next(args, None)
        elif not word.startswith(("--config=", "--board=")):
            command.append(word)
    return command[:2] == ["board", "start"] and "--detach" in command[2:]


def digest(value):
    return hashlib.sha256(value.encode()).hexdigest()


def marker_for(payload, on_board):
    event = payload.get("hook_event_name")
    agent = payload.get("agent_id")
    if event == "SessionStart":
        if not agent and payload.get("source") in START_SOURCES:
            return "startup"
        return None
    if not on_board:
        return None
    if event == "SubagentStart" and isinstance(agent, str) and agent:
        return f"agent-{digest(agent)}"
    tool = payload.get("tool_name")
    if event == "PostToolUse" and tool in TASK_TOOLS:
        return "activity"
    if event == "PreToolUse":
        if tool in AGENT_TOOLS:
            return "activity"
        tool_input = payload.get("tool_input")
        if tool in SHELL_TOOLS and isinstance(tool_input, dict) and detached(tool_input):
            return "activity"
    return None


def session_directory(session):
    temporary = Path(os.environ.get("TMPDIR") or "/tmp")
    return temporary / f"malak-observe-{os.geteuid()}-{digest(session)}"


def open_session(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(fd)
        if metadata.st_uid != os.geteuid() or stat.S_IMODE(metadata.st_mode) != 0o700:
            raise ValueError("observe markers need a private session directory")
        fcntl.flock(fd, fcntl.LOCK_EX)
        if os.stat(path, follow_symlinks=False).st_ino != metadata.st_ino:
            raise ValueError("observe session directory has changed")
        return fd
    except (OSError, ValueError):
        os.close(fd)
        raise


def should_show(path, marker, *, once=False, cooldown=COOLDOWN_SECONDS):
    path.mkdir(mode=0o700, exist_ok=True)
    directory = open_session(path)
    try:
        try:
            fd = os.open(
                marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600, dir_fd=directory
            )
        except FileExistsError:
            fd = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
            try:
                metadata = os.fstat(fd)
                if (
                    not stat.S_ISREG(metadata.st_mode)
                    or once
                    or marker == "startup"
                    or time.time() - metadata.st_mtime < cooldown
                ):
                    return False
                os.utime(fd, None)
            finally:
                os.close(fd)
        else:
            os.close(fd)
        return True
    finally:
        os.close(directory)


def clear_marker(path, marker):
    with suppress(FileNotFoundError):
        directory = open_session(path)
        try:
            os.unlink(marker, dir_fd=directory)
        finally:
            os.close(directory)


def recall_hand_over(path, key):
    try:
        directory = open_session(path)
    except OSError:
        return None
    try:
        fd = os.open(key, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
        with os.fdopen(fd) as source:
            return source.read(64) or None
    except OSError:
        return None
    finally:
        os.close(directory)


def remember_hand_over(path, key, value):
    path.mkdir(mode=0o700, exist_ok=True)
    directory = open_session(path)
    try:
        fd = os.open(key, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        with os.fdopen(fd, "w") as target:
            target.write(value)
    finally:
        os.close(directory)


def turn_end_reply(payload, path, config, session_id):
    """Hand over pending mail and flag a missing lead watcher."""
    from lead_status import watcher_running
    from lead_turn_end import turn_end

    inherited = os.environ.get("MALAK_HANDOVER")
    if inherited is not None and board_identity(inherited)[1] != "lead":
        return None
    active = payload.get("stop_hook_active") is True
    block = False
    mail, watchers = [], []
    for name, board, status in matching_leads(config, session_id):
        if (handover := lead_handover_for(board)) is None:
            continue
        board_key = digest(str(board))
        mail_key = f"turn-end-{board_key}"
        watcher_key = f"turn-end-watcher-{board_key}"
        try:
            running = watcher_running(board)
            line = None
            if running is False:
                command = lead_watcher_command(board, name)
                line = f"Your watcher for board {name} is not running. Restart it: {command}"
            elif running is True:
                clear_marker(path, watcher_key)
            reserved = len(line.encode()) + 2 if line else 0
            reply, current = turn_end(
                name, board, handover, status, recall_hand_over(path, mail_key), active, reserved,
            )
        except (RecipeError, OSError, ValueError, KeyError, TypeError):
            continue
        if reply and "decision" in reply:
            remember_hand_over(path, mail_key, current)
            mail.append(reply["reason"])
            block = True
        elif reply:
            mail.append(reply["systemMessage"])
        if line:
            first = should_show(path, watcher_key, once=True)
            block = block or (first and not active)
            watchers.append(line)
    if block:
        return {"decision": "block", "reason": "\n\n".join(mail + watchers)}
    if mail or watchers:
        return {"systemMessage": " ".join(mail + watchers)}
    return None


def end_session(path):
    directory = open_session(path)
    try:
        for marker in os.listdir(directory):
            if marker in {"startup", "activity", "lead-status", "reminder"} or re.fullmatch(
                r"(agent|reminder-agent|turn-end|turn-end-watcher)-[a-f0-9]{64}", marker,
            ):
                os.unlink(marker, dir_fd=directory)
        path.rmdir()
    finally:
        os.close(directory)


def reminder_marker(payload):
    if payload.get("hook_event_name") == "UserPromptSubmit":
        return "reminder"
    marker = marker_for(payload, True)
    if marker in {"activity", "startup"}:
        # The first touch of a chat, whichever event comes first, shows the intro once.
        return "reminder"
    if marker and marker.startswith("agent-"):
        return f"reminder-{marker}"
    return None


def emit(tool, event, value):
    if (reply := hook_format.reply(tool, event, value)) is not None:
        print(json.dumps(reply))


def main(installed, config, named_tool=None):
    if not installed and os.environ.get("MALAK_OBSERVE") != "1":
        return
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            return
        tool = hook_format.tool_for(payload, named_tool)
        payload = translate(payload)
        session_id = payload.get("session_id")
        if not isinstance(session_id, str) or not session_id:
            session_id = None
        if session_id is None and not (process := hook_process()):
            return
        event = payload.get("hook_event_name")
        path = session_directory(session_id or f"process:{process['pid']}:{process['start_time']}")
        if event == "SessionEnd":
            end_session(path)
            return
        if event == "Stop":
            if installed and (reply := turn_end_reply(payload, path, config, session_id)):
                emit(tool, event, reply)
            return
        handover = os.environ.get("MALAK_HANDOVER")
        marker = (reminder_marker(payload) if installed
                  else marker_for(payload, handover is not None or config is not None))
        if installed:
            intro = marker if marker and not (path / marker).exists() else None
            review = event in {"UserPromptSubmit", "PreToolUse"} and should_show(
                path, "lead-status", cooldown=LEAD_STATUS_INTERVAL_SECONDS,
            )
            question = payload if session_id and is_question(payload) else None
            replied = async_replies(payload.get("prompt")) if session_id and event == "UserPromptSubmit" else []
            delegating = starts_worker(payload)
            if not intro and not review and not question and not replied and not delegating:
                return
            if intro and not should_show(path, intro, once=True):
                intro = None
            lines = hook_context(
                config, handover, intro, session_id, installed=True, review=review,
                question=question, replied=replied, delegating=delegating,
            )
            context = bounded_context(lines)
            signal.setitimer(signal.ITIMER_REAL, 0)
        else:
            if marker is None:
                return
            context = "\n".join(hook_context(config, handover, marker, session_id))
            if not should_show(path, marker):
                return
        if context:
            emit(tool, event, context)
    except Exception:
        # A missing or malformed input, an unreachable board or a bug here is
        # never a reason to block agent work or to look for another handover.
        return


def timed_out(_signal, _frame):
    raise HookDeadline


if __name__ == "__main__":
    if sys.argv[1:2] == ["--reminder"]:
        # The installed hook command: `--reminder [--tool NAME]`. It never
        # reports a usage error, because a failing hook can block the agent's call.
        named = sys.argv[3] if sys.argv[2:3] == ["--tool"] and sys.argv[3:4] else None
        # Leave time for the hook runner to collect the response after the
        # last CLI call. A timeout follows the same silent path as other errors.
        signal.signal(signal.SIGALRM, timed_out)
        signal.setitimer(signal.ITIMER_REAL, 4)
        try:
            main(True, selected_config(), named)
        except Exception:
            pass
    else:
        parser = out.ArgumentParser(
            prog="malak recipe observe",
            usage="MALAK_OBSERVE=1 malak recipe observe [--board NAME | --config PATH] < HOOK_JSON",
            allow_abbrev=False,
        )
        selection = parser.add_mutually_exclusive_group()
        selection.add_argument("--board", metavar="NAME", help="select a named board")
        selection.add_argument("--config", metavar="PATH", type=Path, help="select a board config")
        args = parser.parse_args()
        try:
            config = selected_config(args.board, args.config)
        except ValueError as error:
            parser.error(str(error))
        main(False, config)
